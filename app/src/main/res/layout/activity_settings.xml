<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <!-- 상단 바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/primary_dark"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@android:color/transparent"
            android:text="← 뒤로"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="설정"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:id="@+id/tvPairingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="보호자/어르신 연결"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvPairingDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="연결할 상대방의 전화번호를 입력해주세요."
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:id="@+id/tvPairingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="연결 상태를 확인 중입니다."
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_status"
            android:padding="14dp"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etTargetPhoneNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="상대방 전화번호 (- 제외)"
            android:inputType="phone"
            android:padding="15dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="20dp"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnSubmitPairing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="@color/primary"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="연결 요청하기"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:padding="15dp"/>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnAcceptPairingRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="연결 수락하기"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCancelPairingRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="취소하기"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
