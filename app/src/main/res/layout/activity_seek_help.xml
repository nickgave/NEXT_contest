<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:paddingStart="20dp"
    android:paddingTop="6dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_chip"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="뒤로"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <TextView
            android:id="@+id/tvHelpTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="도움 요청"
            android:textColor="@color/danger"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHelpDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="필요한 연락처를 선택하세요."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnCallCaregiver"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_primary_button"
            android:drawableStart="@drawable/ic_phone"
            android:drawablePadding="12dp"
            android:gravity="center"
            android:text="보호자에게 전화하기"
            android:textColor="@color/text_inverse"
            android:textSize="18sp"
            android:textStyle="bold"
            app:drawableTint="@color/text_inverse" />

        <Button
            android:id="@+id/btnCallPolice"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_danger"
            android:drawableStart="@drawable/ic_help_circle"
            android:drawablePadding="12dp"
            android:gravity="center"
            android:text="경찰(112)에 도움 요청"
            android:textColor="@color/text_inverse"
            android:textSize="18sp"
            android:textStyle="bold"
            app:drawableTint="@color/text_inverse" />
    </LinearLayout>
</ScrollView>
