<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wear_bg_screen"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvMainTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="NEXT Watch"
            android:textColor="@color/wear_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrackingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="위치 공유 준비 중"
            android:textColor="@color/wear_primary"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/wear_bg_panel"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvHomeAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="집 위치 확인 중"
                android:textColor="@color/wear_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="-- m"
                android:textColor="@color/wear_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDirection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="안내 대기"
                android:textColor="@color/wear_warning"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvInstruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxLines="3"
                android:text="집 안내를 시작하면 길 안내가 표시됩니다."
                android:textColor="@color/wear_text"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStartNavigation"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/wear_bg_button_primary"
            android:includeFontPadding="false"
            android:text="집 안내 시작"
            android:textAllCaps="false"
            android:textColor="#052314"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStopNavigation"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/wear_bg_button_secondary"
            android:enabled="false"
            android:includeFontPadding="false"
            android:text="안내 종료"
            android:textAllCaps="false"
            android:textColor="@color/wear_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRepeat"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/wear_bg_button_secondary"
            android:includeFontPadding="false"
            android:text="다시 듣기"
            android:textAllCaps="false"
            android:textColor="@color/wear_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnHelp"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/wear_bg_button_danger"
            android:includeFontPadding="false"
            android:text="도움 요청"
            android:textAllCaps="false"
            android:textColor="#260909"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/wear_bg_button_secondary"
            android:includeFontPadding="false"
            android:text="로그아웃"
            android:textAllCaps="false"
            android:textColor="@color/wear_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
